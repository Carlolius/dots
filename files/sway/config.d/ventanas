# Reglas de ventanas: lo auxiliar flota en vez de partir el mosaico.
for_window [app_id="float"] floating enable, resize set 960 620, move position center
for_window [app_id="pavucontrol"] floating enable, resize set 900 600, move position center
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="org.kde.polkit-kde-authentication-agent-1"] floating enable
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
for_window [app_id="org.freedesktop.impl.portal.desktop.kde"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [title="^Picture-in-Picture$"] floating enable, sticky enable
