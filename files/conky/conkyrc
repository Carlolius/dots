-- conkyrc config

conky.config = {

	-- Various config

	background = true, -- Conky will be forked to background when started
	cpu_avg_samples = 2, -- The number of samples to average for CPU monitoring.
	diskio_avg_samples = 10, -- The number of samples to average for disk I/O monitoring.
	double_buffer = true,  --  (eliminates flicker)
	if_up_strictness = 'address',
	net_avg_samples = 2, -- The number of samples to average for net data
	no_buffers = true, -- Subtract (file system) buffers from used memory?
	temperature_unit = 'celsius',
	update_interval = 1,
	imlib_cache_size = 0,
	total_run_times = 0, -- This is the number of times Conky will update before quitting, set to zero to run forever.

-- Position

	alignment = 'top_right',
	gap_x = 20,
	gap_y = 10,
	maximum_width = 400,
	minimum_width = 250,

-- Graphical

	border_width = 1, -- Border width
	draw_borders = false, -- Draw borders around text
	draw_graph_borders = false,
	draw_shades = false,
	draw_outline = false,
	stippled_borders = 0,

	--Textual

	format_human_readable = true,
	font = 'Trebuchet MS:size=6',
	max_text_width = 0,
	short_units = true,
	use_xft = true,
	xftalpha = 1,
	uppercase = false, -- set to yes if you want all text to be in uppercase

	--Windows

	own_window = true, -- Create own window instead of using desktop (required in nautilus)
	own_window_argb_value = 0,
	own_window_argb_visual = true,
	own_window_type = 'normal',-- # options are: normal/override/dock/desktop/panel -- 'normal' + regla de KWin para mantenerlo detrás (override no es gestionado por KWin, así que los hints/below no le afectan)
	text_buffer_size = 2048,
	own_window_transparent = true,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

	--Colours

	default_color = '#00FF00', -- default color and border color
	color1 = '#68A1DF', -- title_color
	color2 = '#FAA916', -- top memory or processe, graphs
	color3 = '#FBFFFE',	-- text color
	color4 = '#FF5555', -- warnings (temp alta, batería baja)

};

conky.text = [[
${font sans-serif:bold:size=8}SISTEMA ${hr 2}
${font sans-serif:size=8}Kernel: $kernel $alignr $machine
Host:$alignr$nodename
Tiempo encendido:$alignr$uptime

#Bateria#######################################################################
${font sans-serif:bold:size=8}BATERIA ${hr 2}
${font sans-serif:size=8}Estado: ${alignr}${battery BAT0}
Carga: ${alignr}${battery_percent BAT0}%
${battery_bar BAT0}
Tiempo restante: ${alignr}${battery_time BAT0}

#Temperaturas y ventiladores###################################################
${font sans-serif:bold:size=8}TEMPERATURAS ${hr 2}
${font sans-serif:size=8}CPU (Tctl): ${alignr}${execi 3 awk '{printf "%.1f", $1/1000}' /sys/class/hwmon/hwmon4/temp1_input}°C
GPU (edge): ${alignr}${execi 3 awk '{printf "%.1f", $1/1000}' /sys/class/hwmon/hwmon3/temp1_input}°C
NVMe: ${alignr}${execi 3 awk '{printf "%.1f", $1/1000}' /sys/class/hwmon/hwmon1/temp1_input}°C
WiFi (mt7921): ${alignr}${execi 5 awk '{printf "%.1f", $1/1000}' /sys/class/hwmon/hwmon5/temp1_input}°C
Ventilador 1: ${alignr}${execi 3 cat /sys/class/hwmon/hwmon2/fan1_input} RPM
Ventilador 2: ${alignr}${execi 3 cat /sys/class/hwmon/hwmon2/fan2_input} RPM

#Procesador####################################################################
${font sans-serif:bold:size=8}PROCESADOR ${hr 2}
${font sans-serif:size=8}${cpugraph cpu0}
Total: ${cpu cpu0}% ${goto 65}${cpubar cpu0}

#GPU (AMD iGPU)#################################################################
${font sans-serif:bold:size=8}GPU ${hr 2}
${font sans-serif:size=8}Uso: ${alignr}${execi 2 cat /sys/class/drm/card1/device/gpu_busy_percent}%
Potencia (PPT): ${alignr}${execi 3 awk '{printf "%.1f", $1/1000000}' /sys/class/hwmon/hwmon3/power1_input} W

#Memoria#######################################################################
${font sans-serif:bold:size=8}MEMORIA ${hr 2}
${font sans-serif:size=8}RAM $alignc $mem / $memmax $alignr $memperc%
$membar
SWAP $alignc ${swap} / ${swapmax} $alignr ${swapperc}%
${swapbar}
${voffset 5}Name${goto 180}MEM%${alignr}MEM
${top_mem name 1} ${goto 180}${top_mem mem 1}${alignr}${top_mem mem_res 1}
${top_mem name 2} ${goto 180}${top_mem mem 2}${alignr}${top_mem mem_res 2}
${top_mem name 3} ${goto 180}${top_mem mem 3}${alignr}${top_mem mem_res 3}

#Procesos######################################################################
${font sans-serif:bold:size=8}PROCESOS ${hr 2}
${font sans-serif:size=8}#
${voffset 5}Name${goto 180}CPU%${alignr}MEM%
${top name 1} ${goto 180}${top cpu 1}${alignr}${top mem 1}
${top name 2} ${goto 180}${top cpu 2}${alignr}${top mem 2}
${top name 3} ${goto 180}${top cpu 3}${alignr}${top mem 3}

#Discos########################################################################
${font sans-serif:bold:size=8}DISCOS ${hr 2}${font sans-serif:size=8}
/ $alignc ${fs_used /} / ${fs_size /} $alignr ${fs_used_perc /}%
${fs_bar /}
Lectura / Escritura: ${alignr}${diskio_read nvme0n1} / ${diskio_write nvme0n1}

#Internet######################################################################
${font sans-serif:bold:size=8}INTERNET ${hr 2}
${font sans-serif:size=8}IP Externa: ${alignr}${texeci 3600 curl -s --max-time 3 https://icanhazip.com}
${if_existing /sys/class/net/wlp2s0/operstate up}#
Red: $alignr ${wireless_essid wlp2s0}
Señal: $alignr ${wireless_link_qual_perc wlp2s0}%
IP Local: $alignr ${addr wlp2s0}
Descarga: ${downspeed wlp2s0}/s $alignr Subida: ${upspeed wlp2s0}/s
${downspeedgraph wlp2s0 32,120}$alignr ${upspeedgraph wlp2s0 32,120}
Total: ${totaldown wlp2s0} $alignr Total: ${totalup wlp2s0}
${endif}#
${if_existing /sys/class/net/enp1s0/operstate up}#
IP Local (eth): $alignr ${addr enp1s0}
Descarga: ${downspeed enp1s0}/s $alignr Subida: ${upspeed enp1s0}/s
${endif}
]];
