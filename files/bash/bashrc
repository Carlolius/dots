#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Shared environment, aliases and functions (also used by zsh) — edit those files, not here
[ -f ~/.config/envrc ] && source ~/.config/envrc
[ -f ~/.config/aliases ] && source ~/.config/aliases
[ -f ~/.config/functions ] && source ~/.config/functions

# Bash-only overrides: same alias name as in ~/.config/aliases but different
# flags, kept intentionally distinct (loaded after the source above so these
# win). ls/ll/df/myip differ from the zsh versions on purpose.
alias ls="ls -CF --color=auto"
alias ll="ls -lisa --color=auto"
alias df="df -ahiT --total"
alias myip="curl https://ipecho.net/plain; echo"

# Bash-only aliases (no equivalent in ~/.config/aliases)
alias cd..="cd .."
alias lsl="ls -lhFA | less"
alias mkdir="mkdir -pv"
alias userlist="cut -d: -f1 /etc/passwd"
alias fhere="find . -name "
alias free="free -mt"
alias ps="ps auxf"
alias psgrep="ps aux | grep -v grep | grep -i -e VSZ -e"
alias wget="wget -c"
alias histg="history | grep"
alias logs="find /var/log -type f -exec file {} \; | grep 'text' | cut -d' ' -f1 | sed -e's/:$//g' | grep -v '[0-9]$' | xargs tail -f"
alias folders='find . -maxdepth 1 -type d -print0 | xargs -0 du -sk | sort -rn'

# go up N directories (default 1)
up() {
  local d="" i
  for ((i = 1; i <= ${1:-1}; i++)); do
    d="$d/.."
  done
  cd "${d#/}"
}

# create an directory and directly cd into it
mcd() {
  mkdir -p -- "$1" && cd -- "$1"
}

# envrc already puts ~/.local/bin first; add ~/bin as well
PATH="$HOME/bin:$PATH"

export PS1="\[\033[38;5;12m\][\[\033[0m\]\[\033[38;5;10m\]\u\[\033[0m\]\[\033[38;5;12m\]@\[\033[0m\]\[\033[38;5;7m\]\h\[\033[0m\]\[\033[38;5;12m\]]\[\033[0m\]\[\033[38;5;15m\]: \[\033[0m\]\[\033[38;5;7m\]\w\[\033[0m\]\[\033[38;5;12m\]>\[\033[0m\]\[\033[38;5;10m\]\\$\[\033[0m\]\[\033[38;5;15m\] \[\033[0m\]"

[ -e "/etc/DIR_COLORS" ] && DIR_COLORS="/etc/DIR_COLORS"
[ -e "$HOME/.dircolors" ] && DIR_COLORS="$HOME/.dircolors"
[ -e "$DIR_COLORS" ] || DIR_COLORS=""
eval "`dircolors -b $DIR_COLORS`"
