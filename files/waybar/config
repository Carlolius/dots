// vim:ft=json
{
	"layer": "bottom", // Drawn below the windows
	"position": "bottom", // Waybar position (top|bottom|left|right)
	"height": 28,
	// "width": 1280, // Waybar width
	"spacing": 0, // Gaps between modules (4px)
	"mode": "dock",
	// Choose the order of the modules
	"modules-left": [
		"sway/workspaces",
		"sway/mode",
		"sway/scratchpad",
		"custom/media"
	],
	"modules-center": [],
	"modules-right": [
		"cpu",
		"temperature",
		"memory",
		"disk",
		"backlight",
		"custom/noche",
		"custom/despierto",
		"pulseaudio",
		"bluetooth",
		"network#wifi",
		"network#eth",
		"sway/language",
		"custom/vatios",
		"battery",
		"tray",
		"clock",
		"custom/notif",
		"custom/power"
	],
	// Modules configuration
	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": false,
		"format": "{name} {icon}",
		"format-icons": {
			"1": " ",
			"2": " ",
			"3": " ",
			"4": " ",
			"5": " ",
			"urgent": " ",
			"focused": " ",
			"default": " "
		}
	},
	"sway/mode": {
		"format": "<span style=\"italic\">{}</span>",
	},
	"sway/scratchpad": {
		"format": "{icon} {count}",
		"show-empty": false,
		"format-icons": [
			"",
			""
		],
		"tooltip": true,
		"tooltip-format": "{app}: {title}"
	},
	"sway/window": {
		"format": "<span font='Hack Nerd Font 9'>{title}</span>",
		"max-length": 32,
		"format-alt": "{title}",
	},
	"keyboard-state": {
		"capslock": true,
		"format": "{icon} ",
		"format-icons": {
			"locked": "",
			"unlocked": ""
		}
	},
	"sway/language": {
		"format": "󰌌 {shortDescription}",
		"on-click": "swaymsg input type:keyboard xkb_switch_layout next"
	},
	"custom/noche": {
		"exec": "$HOME/.config/sway/scripts/noche.sh status",
		"return-type": "json",
		"interval": 300,
		"signal": 10,
		"on-click": "$HOME/.config/sway/scripts/noche.sh toggle"
	},
	"custom/despierto": {
		"exec": "$HOME/.config/sway/scripts/despierto.sh status",
		"return-type": "json",
		"interval": "once",
		"signal": 8,
		"on-click": "$HOME/.config/sway/scripts/despierto.sh toggle"
	},
	"tray": {
		// "icon-size": 21,
		"spacing": 10
	},
	"clock": {
		"format": "{:%H:%M}",
		"format-alt": "{:%Y-%m-%d %H:%M:%S}",
		"tooltip-format": "<big>{:%d %B %Y}</big>\n<tt><big>{calendar}</big></tt>",
		"on-scroll": {
			"calendar": 1
		},
		"format-calendar-weekdays": "<span color='#ffcc66'><b>{}</b></span>",
		"smooth-scrolling-threshold": 5
	},
	"cpu": {
		"format": "󰻠 {usage}%",
		"tooltip": true,
		"interval": 5
	},
	"memory": {
		"format": "󰍛 {}%",
		"tooltip": true,
		"tooltip-format": "󰍛 {used:0.2f} GiB de {total} GiB\nSwap {swapUsed:0.2f} GiB de {swapTotal:0.2f} GiB"
	},
	"disk": {
		"interval": 30,
		"format": "󰋊 {percentage_used}%",
		"tooltip-format": "{used} de {total} usados\n{free} libres",
		"paths": ["/"]
	},
	"temperature": {
		// hwmonN indices change across reboots/kernel updates, so point at the
		// sensor's stable PCI device (k10temp, AMD CPU) and let waybar find the hwmon.
		// If it ever goes blank: readlink -f /sys/class/hwmon/hwmon*/device (k10temp one).
		"hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
		"input-filename": "temp1_input",
		"critical-threshold": 75,
		// "format-critical": "{temperatureC}°C {icon}",
		"format": "󰔏 {temperatureC}°C",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"tooltip": true,
		// "tooltip-format": "Fan speed: {output-fan}"
	},
	"backlight": {
		"format": "{icon} {percent}%",
		"interval": 2,
		"format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
		"on-click": "brightnessctl set 5%+",
		"on-click-right": "brightnessctl set 5%-",
		"on-scroll-up": "brightnessctl set 1%+",
		"on-scroll-down": "brightnessctl set 1%-",
	},
	"battery": {
		"states": {
			"better": 95,
			"good": 80,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-plugged": "󰚥 {capacity}%",
		"format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
		"tooltip-format": "{timeTo}"
	},
	"network#wifi": {
		"interval": 5,
		"interface": "wl*",
		"format-wifi": "󰖩 {signalStrength}%",
		"format-disconnected": "󰖪",
		"format-disabled": "󰖪",
		"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
		"tooltip-format-disconnected": "Wi-Fi sin conexión",
		"tooltip-format-disabled": "Wi-Fi apagado (click central para encender)",
		"on-click": "$HOME/.config/sway/scripts/toggle-red.sh wifi",
		"on-click-right": "$HOME/.config/sway/scripts/wifi.sh",
		"on-click-middle": "foot nmtui"
	},
	"network#eth": {
		"interval": 5,
		"interface": "en*",
		"format-ethernet": "󰈀",
		"format-disconnected": "",
		"format-linked": "󰈀",
		"tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
		"tooltip-format-linked": "Cable conectado pero sin red",
		"on-click": "$HOME/.config/sway/scripts/toggle-red.sh cable",
		"on-click-right": "$HOME/.config/sway/scripts/wifi.sh",
		"on-click-middle": "foot nmtui"
	},
	"pulseaudio": {
		"format": "{format_source} {icon} {volume}%",
		"format-bluetooth": "{format_source} {icon} {volume}% 󰂯",
		"format-bluetooth-muted": "{format_source} 󰝟 󰂯",
		"format-muted": "{format_source} 󰝟",
		"format-source": "󰍬 {volume}%",
		"format-source-muted": "󰍭",
		"format-icons": {
			"headphone": "󰋋",
			"hands-free": "󰋎",
			"headset": "󰋎",
			"phone": "󰏲",
			"portable": "󰏲",
			"car": "󰄋",
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
		"on-click-middle": "pavucontrol"
	},
	"bluetooth": {
		"format-on": "󰂯",
		"format-off": "󰂲",
		"format-disabled": "", // an empty format will hide the module
		"format-connected": "󰂱 {device_alias}",
		"tooltip-format": "{controller_alias}\t{controller_address}",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
		"on-click": "$HOME/.config/sway/scripts/bluetooth.sh",
		"on-click-right": "bash -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'"
	},
	"custom/media": {
		"format": "{icon} {text}",
		"return-type": "json",
		"max-length": 28,
		"format-icons": {
			"spotify": "",
			"default": ""
		},
		"escape": true,
		"exec": "python $HOME/.config/waybar/mediaplayer.py 2> /dev/null", // Shows whichever player is actually Playing, no filter
		"on-click": "$HOME/.config/sway/scripts/media.sh toggle",
		"on-click-middle": "$HOME/.config/waybar/media-picker.sh", // Pick which player to control when more than one is active
		"on-click-right": "$HOME/.config/sway/scripts/media.sh next",
		"on-scroll-up": "$HOME/.config/sway/scripts/media.sh back",
		"on-scroll-down": "$HOME/.config/sway/scripts/media.sh fwd"
	},
	"custom/power": {
		"format": "󰐥",
		"tooltip-format": "Sesión y energía",
		"on-click": "$HOME/.config/sway/scripts/salir.sh"
	},
	"custom/vatios": {
		"exec": "$HOME/.config/sway/scripts/vatios.sh",
		"return-type": "json",
		"interval": 5,
		"signal": 9,
		"on-click": "$HOME/.config/sway/scripts/vatios.sh perfil"
	},
	"custom/notif": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"notification": "󱅫",
			"none": "󰂜",
			"dnd-notification": "󰂛",
			"dnd-none": "󰪑",
			"inhibited-notification": "󱅫",
			"inhibited-none": "󰂜",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰪑"
		},
		"return-type": "json",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},
}
